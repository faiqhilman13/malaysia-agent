# Postgres in production; SQLite is fine for local development.
MYOPS_DATABASE_URL=sqlite:///./myops.db
# MYOPS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/myops

# Credential vault key(s). Generate with: myops vault generate-key
# Comma-separated for rotation: the first encrypts, all decrypt.
MYOPS_VAULT_KEYS=

# Public URL of this service (approval links, OAuth metadata).
MYOPS_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Extra Host headers accepted by /mcp, as a JSON list, e.g. ["api.example.my"]
MYOPS_MCP_ALLOWED_HOSTS=[]

# How long approval links stay valid.
MYOPS_APPROVAL_TTL_MINUTES=1440

# Optional external OAuth 2.1 authorization server, needed for Claude.ai / ChatGPT connectors.
# Tokens must carry the tenant id and role in these claims.
MYOPS_OAUTH_ISSUER=
MYOPS_OAUTH_AUDIENCE=
MYOPS_OAUTH_JWKS_URL=
MYOPS_OAUTH_TENANT_CLAIM=myops_tenant
MYOPS_OAUTH_ROLE_CLAIM=myops_role

# MyInvois endpoints (defaults shown).
MYOPS_MYINVOIS_PREPROD_API_BASE=https://preprod-api.myinvois.hasil.gov.my
MYOPS_MYINVOIS_PRODUCTION_API_BASE=https://api.myinvois.hasil.gov.my
